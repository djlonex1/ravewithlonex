@import "tailwindcss";

:root {
  --rave-yellow: #efff00;
  --rave-black: #050505;
  --rave-dark: #0b0b0b;
  --rave-white: #f5f5f5;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: var(--rave-black);
  color: var(--rave-white);
  font-family: var(--font-body), Arial, Helvetica, sans-serif;
  overflow-x: hidden;
}

::selection {
  background: var(--rave-yellow);
  color: black;
}

.font-display {
  font-family: var(--font-display), Impact, sans-serif;
}

.text-stroke {
  color: transparent;
  -webkit-text-stroke: 1px rgba(255,255,255,0.7);
}

.yellow-stroke {
  color: transparent;
  -webkit-text-stroke: 1px var(--rave-yellow);
}

.grid-background {
  background-image:
    linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px),
    linear-gradient(
      90deg,
      rgba(255,255,255,0.025) 1px,
      transparent 1px
    );
  background-size: 50px 50px;
}

.marquee {
  overflow: hidden;
  white-space: nowrap;
}

.marquee-track {
  display: inline-flex;
  min-width: max-content;
  animation: marquee 22s linear infinite;
}

@keyframes marquee {
  from {
    transform: translateX(0);
  }

  to {
    transform: translateX(-50%);
  }
}

::-webkit-scrollbar {
  width: 7px;
}

::-webkit-scrollbar-track {
  background: #050505;
}

::-webkit-scrollbar-thumb {
  background: #efff00;
}
.rave-glow {
  box-shadow:
    0 0 20px rgba(239, 255, 0, 0.15),
    0 0 60px rgba(239, 255, 0, 0.08);
}

.rave-text-glow {
  text-shadow:
    0 0 15px rgba(239, 255, 0, 0.3),
    0 0 40px rgba(239, 255, 0, 0.15);
}

.image-noise::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: 0.07;
  background-image:
    radial-gradient(circle, white 1px, transparent 1px);
  background-size: 5px 5px;
}

@media (min-width: 768px) {
  a,
  button {
    cursor: pointer;
  }
}


/* ========================================
   RAVEWITHLONEX LIGHT / DARK THEME
======================================== */

html {
  color-scheme: dark;
}

html.light {
  color-scheme: light;
}

body {
  transition:
    background-color 0.35s ease,
    color 0.35s ease;
}

/* =========================
   LIGHT MODE FOUNDATION
========================= */

html.light body {
  background: #f3f1e8;
  color: #090909;
}

/* Main neutral backgrounds */

html.light .bg-black {
  background-color: #f3f1e8 !important;
}

html.light [class*="bg-[#080808]"],
html.light [class*="bg-[#070707]"],
html.light [class*="bg-[#0a0a0a]"],
html.light [class*="bg-[#0c0c0c]"],
html.light [class*="bg-[#111]"] {
  background-color: #fffef7 !important;
}

/* =========================
   LIGHT MODE TYPOGRAPHY
========================= */

html.light .text-white {
  color: #090909 !important;
}

html.light [class*="text-white/"] {
  color: rgba(9, 9, 9, 0.62) !important;
}

html.light [class*="border-white/"] {
  border-color: rgba(0, 0, 0, 0.15) !important;
}

/* Outlined typography needs dark outline */

html.light .text-stroke {
  color: transparent;
  -webkit-text-stroke: 1px rgba(0, 0, 0, 0.75);
}

/* Yellow outline remains part of brand */

html.light .yellow-stroke {
  color: transparent;
  -webkit-text-stroke: 1px #efff00;
}

/* Light mode grid */

html.light .grid-background {
  background-image:
    linear-gradient(
      rgba(0, 0, 0, 0.055) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(0, 0, 0, 0.055) 1px,
      transparent 1px
    );
}

/* =========================
   NAVBAR
========================= */

html.light header {
  background: rgba(243, 241, 232, 0.88) !important;
  color: #090909;
  border-color: rgba(0, 0, 0, 0.12) !important;
}

html.light header nav a {
  color: rgba(0, 0, 0, 0.62) !important;
}

html.light header nav a:hover {
  color: #111 !important;
}

/* =========================
   ALWAYS DARK AREAS
   Hero / photos / event cards / tickets
========================= */

html.light .always-dark {
  color: #ffffff;
}

/* Force backgrounds inside always-dark areas back to dark */

html.light .always-dark.bg-black {
  background-color: #000 !important;
}

html.light .always-dark[class*="bg-[#0a0a0a]"],
html.light .always-dark[class*="bg-[#0c0c0c]"],
html.light .always-dark[class*="bg-[#111]"] {
  background-color: #0a0a0a !important;
}

/* White text must remain white inside dark/image sections */

html.light .always-dark .text-white,
html.light .always-dark.text-white {
  color: #fff !important;
}

html.light .always-dark [class*="text-white/"],
html.light .always-dark[class*="text-white/"] {
  color: rgba(255, 255, 255, 0.62) !important;
}

html.light .always-dark [class*="border-white/"],
html.light .always-dark[class*="border-white/"] {
  border-color: rgba(255, 255, 255, 0.17) !important;
}

/* Keep outlined text readable inside dark areas */

html.light .always-dark .text-stroke {
  -webkit-text-stroke: 1px rgba(255, 255, 255, 0.75);
}

/* Hero must always look like rave/night mode */

html.light #home {
  color: #fff;
}

html.light #home .text-white {
  color: #fff !important;
}

html.light #home [class*="text-white/"] {
  color: rgba(255, 255, 255, 0.62) !important;
}

html.light #home [class*="border-white/"] {
  border-color: rgba(255, 255, 255, 0.18) !important;
}

/* =========================
   BRAND YELLOW
========================= */

html.light .bg-\[\#efff00\] {
  background-color: #efff00 !important;
}

html.light .text-\[\#efff00\] {
  color: #efff00 !important;
}

/* Black text on yellow must stay black */

html.light .bg-\[\#efff00\].text-black,
html.light .bg-\[\#efff00\] .text-black {
  color: #000 !important;
}

/* =========================
   FORM CONTROLS
========================= */

html.light input,
html.light textarea,
html.light select {
  color: #090909;
}

html.light input::placeholder,
html.light textarea::placeholder {
  color: rgba(0, 0, 0, 0.42) !important;
}

html.light select {
  background-color: #fffef7 !important;
}

/* Join Movement is yellow, so keep its fields dark */

html.light #join input,
html.light #join textarea,
html.light #join select {
  color: #000;
}

/* =========================
   THEME TOGGLE
========================= */

.theme-toggle {
  color: inherit;
}

html.light .theme-toggle {
  background: rgba(255, 255, 255, 0.72);
  border-color: rgba(0, 0, 0, 0.18);
  color: #090909;
}

/* =========================
   SCROLLBAR
========================= */

html.light ::-webkit-scrollbar-track {
  background: #f3f1e8;
}

html.light ::-webkit-scrollbar-thumb {
  background: #111;
}

/* =========================
   NOISE
========================= */

html.light body::before {
  opacity: 0.025;
  filter: invert(1);
}
